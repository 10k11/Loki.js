POP_VOICE_CHANNEL_ID=your_pop_voice_channel_id

# User ID allowed to use /radio stop/start/restart etc.
RADIO_ADMIN_USER_IDS=your_discord_user_id

# Bot User IDs used for unmute/perms scripts
STUDY_BOT_USER_ID=your_study_bot_user_id
POP_BOT_USER_ID=your_pop_bot_user_id

# Market Automation Feature
MARKET_ANALYSIS_CHANNEL_ID=your_market_analysis_channel_id
MARKET_NEWS_CHANNEL_ID=your_market_news_channel_id
