DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_discord_guild_id_here

CTF_RADAR_CHANNEL=ctf-calendar
MISTRAL_API_KEY=your_mistral_api_key_here

# 24/7 Radio Feature Configuration
STUDY_RADIO_BOT_TOKEN=your_study_radio_bot_token_here
POP_RADIO_BOT_TOKEN=your_pop_radio_bot_token_here

STUDY_STREAM_URL=http://lofi.stream.laut.fm/lofi
POP_STREAM_URL=http://media-ice.musicradio.com/CapitalMP3

# Voice Channels (run /radio setup in discord first to generate channels, then get their IDs)
